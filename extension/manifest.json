{
  "manifest_version": 3,
  "name": "VaultSafe Local",
  "version": "3.3.3",
  "description": "Détecter les comptes, les enregistrer en un clic, remplir les formulaires et générer des mots de passe avec VaultSafe.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
  "action": {
    "default_title": "VaultSafe Local",
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"}
  },
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "minimum_chrome_version": "109",
  "content_scripts": [{
    "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
    "js": ["capture.js"], "run_at": "document_start", "all_frames": false
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "web_accessible_resources": [{
    "resources": ["capture-panel.html", "capture-panel.css", "capture-panel.js", "brand.svg"],
    "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"]
  }],
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
